# Copy to .env and edit. Never commit real secrets.
# Wi-Fi passwords must NOT be stored here. Use the dashboard ESP32 setup form.

AURA_WEB_HOST=127.0.0.1
AURA_WEB_PORT=8080
AURA_ALLOW_LAN=false
AURA_API_TOKEN=

AURA_CAMERA_INDEX=0
AURA_DEMO_MODE=false
AURA_EYE_TRACKING=false
AURA_EXTENDED_GESTURES=false

# Optional static ESP32 IP (skips UDP discovery)
AURA_ESP32_IP=

# Optional: change only if you also change firmware
AURA_ESP32_HTTP_PORT=80
AURA_DISCOVERY_PORT=4210
